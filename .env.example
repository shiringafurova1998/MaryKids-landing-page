# Telegram bot (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Arizalar keladigan chat ID (shaxsiy chat, guruh yoki kanal)
TELEGRAM_CHAT_ID=-1001234567890
# Saytdagi "Telegram kanalga o'tish" tugmasi havolasi
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/marykids

# --- Meta (Facebook/Instagram) ---
# Events Manager → Data sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# Events Manager → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
# Faqat test paytida (Events Manager → Test events → TEST12345). Ishga tushgach o'chiring.
META_TEST_EVENT_CODE=
# Graph API versiyasi (ixtiyoriy)
META_API_VERSION=v23.0
